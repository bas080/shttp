#!/usr/bin/env node

// shttp - Node.js HTTP proxy server
// Execute whitelisted commands from PATH via HTTP.
//
// Environment variables:
//   SHTTP_ENDPOINT          Server endpoint (default: http://localhost:8080). The port is extracted from this URL.
//   SHTTP_ALLOWED_COMMANDS  Whitelist (e.g. "git curl wget python")

const http = require('http');
const { spawn } = require('child_process');
const debug = require('debug')('shttp');

process.title = 'shttp';

const SHTTP_ENDPOINT = process.env.SHTTP_ENDPOINT || 'http://localhost:8080';

const MAX_BODY_SIZE = 10 * 1024 * 1024;
const MAX_OUTPUT_SIZE = 5 * 1024 * 1024;
const MAX_STDERR_HEADER_SIZE = 4096;
const TIMEOUT_MS = 30000;
const KILL_GRACE_MS = 1000;

let allowedCommands = parseAllowedCommands();

function parseAllowedCommands() {
  return (process.env.SHTTP_ALLOWED_COMMANDS || '')
    .split(/[,\s]+/)
    .map(s => s.trim())
    .filter(Boolean);
}

const server = http.createServer(async (req, res) => {
  debug('incoming request: %s %s', req.method, req.url);

  if (req.method === 'GET' && req.url === '/bash') {
    const funcs = [];

    funcs.push(`shttp_client() {
  local cmd="$1"
  shift

  local payload
  local headers_file
  local output_file
  local curl_status
  local exit_code
  local remote_stderr

  payload=$(command jq -cn --args '$ARGS.positional' "$cmd" "$@") || return 1

  headers_file=$(command mktemp) || return 1
  output_file=$(command mktemp) || {
    command rm -f "$headers_file"
    return 1
  }

  {
    builtin printf '%s\\n' "$payload"

    if [ ! -t 0 ]; then
      command cat
    fi
  } | command curl --fail --silent --show-error \\
      --data-binary @- \\
      -D "$headers_file" \\
      -o "$output_file" \\
      "${SHTTP_ENDPOINT}/"

  curl_status=$?

  if [ "$curl_status" -ne 0 ]; then
    command cat "$output_file" >&2
    command rm -f "$headers_file" "$output_file"
    return "$curl_status"
  fi

  exit_code=$(command awk 'tolower($1) == "x-shttp-exit-code:" {gsub("\\\\r", "", $2); print $2}' "$headers_file")

  remote_stderr=$(command awk 'tolower($1) == "x-shttp-stderr:" {gsub("\\\\r", "", $2); print $2}' "$headers_file")

  if [ -n "$remote_stderr" ]; then
    builtin printf '%s' "$remote_stderr" | command base64 -d >&2
  fi

  command cat "$output_file"

  command rm -f "$headers_file" "$output_file"

  [[ "$exit_code" =~ ^[0-9]+$ ]] || exit_code=1
  return "$exit_code"
}`);

    const reserved = new Set([
      'builtin', 'command',
      'if', 'then', 'else', 'elif', 'fi',
      'for', 'while', 'until', 'do', 'done',
      'case', 'esac', 'in', 'function',
      'select', 'time', 'coproc',
      'shttp_client'
    ]);

    for (const cmd of allowedCommands) {
      if (!/^[a-zA-Z0-9_-]+$/.test(cmd) || reserved.has(cmd)) {
        continue;
      }

      funcs.push(`function ${cmd} {
  shttp_client '${cmd}' "$@"
}`);
    }

    res.writeHead(200, {
      'Content-Type': 'text/plain; charset=utf-8'
    });

    res.end(funcs.join('\n\n') + '\n');
    return;
  }

  if (req.method !== 'POST' || req.url !== '/') {
    res.writeHead(405, {
      'Content-Type': 'text/plain'
    });
    res.end('Method not allowed. Use POST /');
    return;
  }

  try {
    await readAndProcessRequest(req, res);
  } catch (err) {
    debug('server error: %s', err.message);

    if (!res.headersSent) {
      res.writeHead(500, {
        'Content-Type': 'text/plain'
      });
    }

    res.end('Server error: ' + err.message);
  }
});

function killProcessGroup(child, signal) {
  if (!child.pid) return;

  try {
    if (process.platform !== 'win32') {
      process.kill(-child.pid, signal);
    } else {
      child.kill(signal);
    }
  } catch (err) {
    if (err.code !== 'ESRCH') {
      debug('kill error: %s', err.message);
    }
  }
}

function executeCommand(cmd, args, stdinData) {
  debug('executing: %s %j', cmd, args);

  

  return new Promise(resolve => {
    const child = spawn(cmd, args, {
      shell: false,
      stdio: ['pipe', 'pipe', 'pipe'],
      env: process.env,
      detached: process.platform !== 'win32'
    });

    let stdout = [];
    let stderr = [];
    let outputSize = 0;
    let settled = false;
    let timedOut = false;
    let outputLimitExceeded = false;
    let killTimer;

    const finish = result => {
      if (settled) return;
      settled = true;

      clearTimeout(timeoutTimer);
      clearTimeout(killTimer);

      resolve(result);
    };

    const terminate = () => {
      killProcessGroup(child, 'SIGTERM');

      killTimer = setTimeout(() => {
        killProcessGroup(child, 'SIGKILL');
      }, KILL_GRACE_MS);

      killTimer.unref();
    };

    const timeoutTimer = setTimeout(() => {
      timedOut = true;
      debug('command timeout: %s', cmd);
      terminate();
    }, TIMEOUT_MS);

    function collect(target, chunk) {
      outputSize += chunk.length;

      if (outputSize > MAX_OUTPUT_SIZE) {
        if (!outputLimitExceeded) {
          outputLimitExceeded = true;
          debug('output limit exceeded: %s', cmd);
          terminate();
        }
        return;
      }

      target.push(chunk);
    }

    child.stdout.on('data', chunk => {
      collect(stdout, chunk);
    });

    child.stderr.on('data', chunk => {
      collect(stderr, chunk);
    });

    child.on('error', err => {
      debug('child process error: %s', err.message);

      finish({
        stdout: Buffer.alloc(0),
        stderr: Buffer.from(err.message),
        exitCode: 1
      });
    });

    child.on('close', (code, signal) => {
      debug('child exited: code=%s signal=%s', code, signal);

      finish({
        stdout: Buffer.concat(stdout),
        stderr: Buffer.concat(stderr),
        exitCode: timedOut || outputLimitExceeded ? 1 : (code ?? 1),
        timedOut,
        outputLimitExceeded
      });
    });

    child.stdin.on('error', err => {
      debug('stdin error: %s', err.message);
    });

    child.stdin.end(stdinData);
  });
}

async function readAndProcessRequest(req, res) {
  const chunks = [];
  let bodySize = 0;

  for await (const chunk of req) {
    bodySize += chunk.length;

    if (bodySize > MAX_BODY_SIZE) {
      res.writeHead(413, {
        'Content-Type': 'text/plain'
      });
      res.end('Request body too large');
      return;
    }

    chunks.push(chunk);
  }

  const body = Buffer.concat(chunks);
  const separatorIndex = body.indexOf(0x0a);

  if (separatorIndex === -1) {
    debug("Body length: %d", body.length);
    debug("Body: %s", body.toString());
    res.writeHead(400, {
      'Content-Type': 'text/plain'
    });
    res.end('Missing argument line');
    return;
  }

  const argsLine = body.subarray(0, separatorIndex)
    .toString('utf8')
    .replace(/\r$/, '');

  const stdinData = body.subarray(separatorIndex + 1);

  let args;

  try {
    args = JSON.parse(argsLine);
  } catch {
    res.writeHead(400, {
      'Content-Type': 'text/plain'
    });
    res.end('Invalid JSON argument array');
    return;
  }

  if (
    !Array.isArray(args) ||
    args.length === 0 ||
    args.some(arg => typeof arg !== 'string' || arg.includes('\0'))
  ) {
    res.writeHead(400, {
      'Content-Type': 'text/plain'
    });
    res.end('Invalid command arguments');
    return;
  }

  const [cmd, ...commandArgs] = args;

  if (!cmd || cmd.includes('\0')) {
    res.writeHead(400, {
      'Content-Type': 'text/plain'
    });
    res.end('Missing command');
    return;
  }

  debug('command: %s, args: %j, stdin bytes: %d',
    cmd, commandArgs, stdinData.length);

  if (!allowedCommands.includes(cmd)) {
    res.writeHead(403, {
      'Content-Type': 'text/plain'
    });
    res.end(`Command "${cmd}" is not allowed`);
    return;
  }

  const result = await executeCommand(cmd, commandArgs, stdinData);

  const headers = {
    'Content-Type': 'application/octet-stream',
    'X-SHTTP-Exit-Code': String(result.exitCode)
  };

  if (result.stderr.length > 0) {
    headers['X-SHTTP-Stderr'] = result.stderr
      .subarray(0, MAX_STDERR_HEADER_SIZE)
      .toString('base64');
  }

  if (result.stderr.length > MAX_STDERR_HEADER_SIZE) {
    headers['X-SHTTP-Stderr-Truncated'] = 'true';
  }

  if (result.timedOut) {
    headers['X-SHTTP-Timeout'] = 'true';
  }

  if (result.outputLimitExceeded) {
    headers['X-SHTTP-Output-Limit'] = 'true';
  }

  res.writeHead(
    result.outputLimitExceeded ? 507 : 200,
    headers
  );

  res.end(result.stdout);
}

// Refresh whitelist from environment.
setInterval(() => {
  allowedCommands = parseAllowedCommands();
}, 60000).unref();

const SHTTP_URL = new URL(SHTTP_ENDPOINT);

server.listen(SHTTP_URL.port || 8080, () => {
  debug('shttp listening on %s', SHTTP_ENDPOINT);
  debug('Whitelist: %s', allowedCommands.join(' ') || '(none)');
  debug('Endpoint: POST /');
  debug('Body format: first line = JSON argv, remaining bytes = stdin');
});
